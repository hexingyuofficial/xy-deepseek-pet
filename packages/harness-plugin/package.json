{
  "name": "xy-deepseek-pet",
  "version": "0.1.0",
  "description": "Harness adapter bundle for XY DeepSeek Pet",
  "keywords": ["deepseek", "deepseek-harness", "cordis", "desktop-pet", "electron"],
  "homepage": "https://github.com/hexingyuofficial/xy-deepseek-pet#readme",
  "bugs": { "url": "https://github.com/hexingyuofficial/xy-deepseek-pet/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/hexingyuofficial/xy-deepseek-pet.git", "directory": "packages/harness-plugin" },
  "engines": { "node": ">=22" },
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.js",
    "./remote": "./lib/remote.js",
    "./package.json": "./package.json"
  },
  "files": ["assets", "lib", "runtime/launch.mjs", "runtime/launcher-utils.mjs", "cordis.patch.yml", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "xy-deepseek-desktop": "workspace:0.1.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-commands": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@types/ws": "^8.18.1",
    "@xy-deepseek-pet/protocol": "workspace:*",
    "esbuild": "^0.25.9",
    "vitest": "^3.2.4",
    "react": "^18.3.1",
    "@types/react": "~18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
